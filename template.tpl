    ]);

    ['uetq', 'uetq_222', 'uetq_333'].forEach((queueName) => {
      const pushes = getUetPushes().filter((p) => p[0] === queueName);
      assertThat(pushes).isEqualTo([
        [queueName, 'consent', 'default', { ad_storage: 'granted' }],
        [queueName, 'set', { rep: '1' }],
        [
          queueName,
          'event',
          'purchase',
          { revenue_value: '10', rep: '1', pid: { em: 'john@example.com' } }
        ]
      ]);
    });

    assertApi('gtmOnSuccess').wasCalled();
    assertApi('gtmOnFailure').wasNotCalled();
- name: '[Multiple Tag IDs] Array of Tag IDs with custom queue name, Page View and consent per queue'
  code: |-
    const mockData = createMockData({
      tagId: ['111', 222],
      uetqName: 'myq',
      enableGoogleConsentMode: true
    });
    runCode(mockData);
    runCode(mockData);

    assertThat(getUetPushes()).isEqualTo([
      ['myq', 'consent', 'default', { ad_storage: 'granted' }],
      ['myq', 'pageLoad'],
      ['myq_222', 'consent', 'default', { ad_storage: 'granted' }],
      ['myq_222', 'pageLoad'],
      ['myq', 'event', 'page_view', { page_path: '/products?a=1', page_title: 'Page Title' }],
      ['myq_222', 'event', 'page_view', { page_path: '/products?a=1', page_title: 'Page Title' }]
    ]);

    // One Google Consent Mode listener per queue, each one updating its own queue.
    assertThat(consentListeners.length).isEqualTo(2);
    consentListeners.forEach((listener) => listener('ad_storage', false));
    const updates = getUetPushes().slice(6);
    assertThat(updates).isEqualTo([
      ['myq', 'consent', 'update', { ad_storage: 'denied' }],
      ['myq_222', 'consent', 'update', { ad_storage: 'denied' }]
    ]);

    assertApi('gtmOnSuccess').wasCalled();
    assertApi('gtmOnFailure').wasNotCalled();
- name: '[Multiple Tag IDs] Each Tag ID keeps its queue across tags, whatever its position in the list'
  code: |-
    runCode(createMockData({ tagId: '222' }));
    runCode(createMockData({ tagId: '111, 222' }));
    runCode(createMockData({ tagId: ['222', '111', '333'] }));
    runCode(createMockData({ tagId: '111', uetqName: 'myq' }));

    const inits = windowCalls.filter((c) => c.fn === 'UET_init').map((c) => [c.args[0], c.args[1].ti]);
    assertThat(inits).isEqualTo([
      ['uetq', '222'],
      ['uetq_111', '111'],
      ['uetq', '222'],
      ['uetq', '222'],
      ['uetq_111', '111'],
      ['uetq_333', '333'],
      ['myq', '111']
    ]);

    // Each queue sends its page load only once.
    const pageLoads = getUetPushes()
      .filter((p) => p[1] === 'pageLoad')
      .map((p) => p[0]);
    assertThat(pageLoads).isEqualTo(['uetq', 'uetq_111', 'uetq_333', 'myq']);

    assertApi('gtmOnSuccess').wasCalled();
    assertApi('gtmOnFailure').wasNotCalled();
