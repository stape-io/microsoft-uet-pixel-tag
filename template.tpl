setup: |-
  const JSON = require('JSON');
  const Object = require('Object');

  const hashA = 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa';
  const hashB = 'bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb';

  const assign = (target, source) => {
    if (!source) return target;
    Object.keys(source).forEach((key) => {
      target[key] = source[key];
    });
    return target;
  };

  const baseMockData = {
    tagId: '1234567',
    eventNameSetupMethod: 'override',
    eventType: 'pageView',
    enableDataLayerMapping: false,
    enableMostRecentDataLayerEventOnly: false,
    enableEnhancedConversions: true,
    enableEventUserDataEnhancement: false,
    enableGoogleConsentMode: false,
    consentMode: 'advanced',
    enableTcf: false,
    userDataFromVariable: false,
    eventParametersFromVariable: false,
    pushEventIdToDataLayer: false,
    uetqName: 'uetq'
  };

  const createMockData = (overrides) => assign(assign({}, baseMockData), overrides);

  let injectScriptCalls;
  let injectScriptShouldFail;
  let windowCalls;
  let dataLayerValues;
  let dataLayerVersions;
  let consentListeners;
  let templateStorageData;
  let localStorageData;
  let localStorageReads;
  let localStorageWrites;
  let sha256Inputs;
  let queuePushes;

  const getUetPushes = () =>
    windowCalls.filter((c) => c.fn === 'UET_push').map((c) => c.args);

  const cleanup = () => {
    injectScriptCalls = [];
    injectScriptShouldFail = false;
    windowCalls = [];
    dataLayerValues = {};
    dataLayerVersions = [];
    consentListeners = [];
    templateStorageData = {};
    localStorageData = {};
    localStorageReads = 0;
    localStorageWrites = 0;
    sha256Inputs = [];
    queuePushes = [];
  };
  cleanup();

  mock('injectScript', (url, onSuccess, onFailure, cacheToken) => {
    injectScriptCalls.push({ url: url, cacheToken: cacheToken });
    if (injectScriptShouldFail) onFailure();
    else onSuccess();
  });

  mock('callInWindow', (fn, a1, a2, a3, a4) => {
    const args = [a1, a2, a3, a4];
    while (args.length && args[args.length - 1] === undefined) args.pop();
    windowCalls.push({ fn: fn, args: args });
  });

  mock('copyFromDataLayer', (key, version) => {
    dataLayerVersions.push(version);
    return dataLayerValues[key];
  });

  mock('isConsentGranted', () => true);

  mock('addConsentListener', (consentType, listener) => {
    consentListeners.push(listener);
  });

  mockObject('templateStorage', {
    getItem: (key) => templateStorageData[key],
    setItem: (key, value) => {
      templateStorageData[key] = value;
    }
  });

  mockObject('localStorage', {
    getItem: (key) => {
      localStorageReads++;
      return localStorageData[key];
    },
    setItem: (key, value) => {
      localStorageWrites++;
      localStorageData[key] = value;
    }
  });

  mock('sha256', (input, onSuccess, onFailure, options) => {
    sha256Inputs.push(input);
    onSuccess(input.indexOf('@') !== -1 ? hashA : hashB);
  });

  mock('createQueue', (name) => {
    return (item) => {
      queuePushes.push({ name: name, item: item });
    };
  });

  mock('getUrl', (component) => {
    if (component === 'path') return '/products';
    if (component === 'query') return 'a=1';
    return 'https://example.com/products?a=1';
  });

  mock('readTitle', 'Page Title');


