    assertThat(localStorageReads).isEqualTo(0);
    assertThat(localStorageWrites).isEqualTo(0);
    assertThat(getUetPushes()[1]).isEqualTo(['uetq', 'set', { pid: { em: 'john@example.com' } }]);

    assertApi('gtmOnSuccess').wasCalled();
    assertApi('gtmOnFailure').wasNotCalled();
