- name: '[Failure] bat js load failure calls gtmOnFailure'
  code: |-
    injectScriptShouldFail = true;

    runCode(createMockData({}));

    assertThat(injectScriptCalls.length).isEqualTo(1);
    assertThat(windowCalls.length).isEqualTo(0);
